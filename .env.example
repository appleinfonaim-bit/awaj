# ---------------------------------------------------------------------------
# AWAJ - Environment configuration
# Copy this file to `.env` and adjust. Every value has a safe default, so the
# app boots even without a .env file.
# ---------------------------------------------------------------------------

# HTTP port
PORT=3000

# Public site URL (used for canonical tags, sitemap, Open Graph)
SITE_URL=http://localhost:3000

# Comma separated list. Use * to allow any origin (fine for local dev).
CORS_ORIGIN=*

# --- Security --------------------------------------------------------------
# CHANGE THIS in production. It is used to sign admin session cookies.
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Session lifetime in hours (admin login sessions)
SESSION_TTL_HOURS=12

# Set to 1 when serving over HTTPS so cookies get the Secure flag
SECURE_COOKIES=0

# --- Storefront contact details -------------------------------------------
# These seed the settings table on first run. Everything is editable later in
# Admin > Settings, so the website never hard-codes unavailable contact info.
WHATSAPP_NUMBER=8801700000000
SUPPORT_PHONE=+8801700000000
SUPPORT_EMAIL=hello@awaj.com
FACEBOOK_PAGE_URL=
FACEBOOK_USERNAME=
INSTAGRAM_URL=
TIKTOK_URL=

# --- Order / delivery defaults (all editable in Admin > Settings) -----------
DELIVERY_INSIDE_DHAKA=80
DELIVERY_OUTSIDE_DHAKA=130
# Free delivery when order subtotal reaches this amount. 0 disables it.
FREE_DELIVERY_THRESHOLD=0

# --- Admin bootstrap account ----------------------------------------------
# Created on first `npm run seed`. Password is hashed with scrypt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Behaviour -------------------------------------------------------------
# Set to 1 to refuse all writes except admin (useful while trialling).
MAINTENANCE_MODE=0

# Optional external image-search provider (section 4 of Requirement.md).
# Leave blank to use the built-in offline colour-match provider.
IMAGE_SEARCH_API_URL=
IMAGE_SEARCH_API_KEY=
